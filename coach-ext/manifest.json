{
  "manifest_version": 3,
  "name": "Coach — sonde web",
  "version": "0.1.0",
  "description": "Mesure le temps par catégorie et l'envoie au coach. Aucune URL ne quitte le navigateur.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "options_page": "src/options.html",
  "action": {
    "default_title": "Coach — sonde web",
    "default_popup": "src/options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "coach-sonde-web@mael.local",
      "strict_min_version": "115.0"
    }
  }
}
